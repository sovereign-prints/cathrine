/* ============ LOGO STYLING UPDATES ============ */

/* Logo Link - Make logo clickable to return home */
.logo-link {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
  transition: opacity 0.2s ease;
  border-radius: 4px;
  padding: 5px;
}

.logo-link:hover {
  opacity: 0.8;
}

.logo-link:active {
  opacity: 0.6;
}

/* Logo Mark - Navbar logo (now using image) */
.logo-mark {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: block;
  transition: transform 0.2s ease;
}

.logo-link:hover .logo-mark {
  transform: scale(1.05);
}

/* Hero Logo - Large logo in hero section */
.hero-logo {
  width: 120px;
  height: 120px;
  margin-bottom: 30px;
  display: block;
}

/* Admin Login Logo - Login screen logo */
.login-logo {
  width: 80px;
  height: 80px;
  display: block;
  margin: 0 auto 20px;
}

/* Mobile Responsive - Adjust sizes for smaller screens */
@media (max-width: 768px) {
  .logo-mark {
    width: 36px;
    height: 36px;
  }

  .hero-logo {
    width: 100px;
    height: 100px;
  }

  .login-logo {
    width: 70px;
    height: 70px;
  }
}

@media (max-width: 480px) {
  .logo-mark {
    width: 32px;
    height: 32px;
  }

  .hero-logo {
    width: 80px;
    height: 80px;
  }

  .login-logo {
    width: 60px;
    height: 60px;
  }
}
